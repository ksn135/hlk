<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}ЛК контрагента{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📄</text></svg>">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
{% set currentRoute = app.request.attributes.get('_route') %}
{% if app.user %}
<header class="topbar">
    <div class="topbar-brand"><a href="{{ path('app_home') }}">ЛК контрагента</a></div>
    <nav class="topbar-nav">
        <a href="{{ path('app_home') }}" class="{{ currentRoute == 'app_home' ? 'active' : '' }}">Активные</a>
        <a href="{{ path('app_archive') }}" class="{{ currentRoute == 'app_archive' ? 'active' : '' }}">Архив</a>
    </nav>
    <div class="topbar-user">
        <span>{{ app.user.title }}</span>
        <a href="{{ path('app_logout') }}">Выйти</a>
    </div>
</header>
{% endif %}

<main class="page">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
